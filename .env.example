# Copiá este archivo a .env y completá con los datos de tu proyecto Firebase
# (Consola Firebase > Configuración del proyecto > Tus apps > Web).
# Si lo dejás vacío, la app funciona en "modo local" (datos en este navegador) para probar.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
